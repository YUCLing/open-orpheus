{
  "name": "open-orpheus",
  "productName": "open-orpheus",
  "version": "0.19.1",
  "description": "An open-source implementation of Netease Cloud Music's Orpheus browser host.",
  "type": "module",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build:modules": "node scripts/build-modules.ts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:srpm": "node scripts/build-srpm.ts",
    "make:rpm": "node scripts/build-rpm.ts",
    "make:deb-src": "node scripts/build-deb-src.ts",
    "make:deb": "node scripts/build-deb.ts",
    "publish": "electron-forge publish",
    "lint": "pnpm lint:oxlint && pnpm lint:gui",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:gui": "pnpm lint:gui:eslint && pnpm lint:gui:check",
    "lint:gui:eslint": "pnpm --dir gui lint",
    "lint:gui:check": "pnpm --dir gui check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "YUCLing",
    "email": "luotianyi@luotianyi.me"
