    "@types/unzipper": "^0.10.11",
    "cookie": "^2.0.1",
    "emittery": "^2.2.0",
    "got": "^16.2.0",
    "keyv": "6.1.0",
    "music-tag-native": "^1.2.0",
    "pino": "^10.4.0",
