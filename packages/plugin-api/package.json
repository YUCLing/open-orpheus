{
  "name": "@open-orpheus/plugin-api",
  "version": "0.20.0",
  "description": "Type surface for Open Orpheus plugins (generated from the host).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "YUCLing",
    "email": "luotianyi@luotianyi.me"
  },
  "homepage": "https://github.com/YUCLing/open-orpheus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUCLing/open-orpheus.git",
    "directory": "packages/plugin-api"
  },
  "bugs": {
    "url": "https://github.com/YUCLing/open-orpheus/issues"
  },
  "keywords": [
    "open-orpheus",
    "plugin",
    "types"
